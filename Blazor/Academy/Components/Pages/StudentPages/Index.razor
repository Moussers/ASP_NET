@page "/students"
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using Academy.Models
@implements IAsyncDisposable
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Index</PageTitle>

<h1>Index</h1>

<p>
    <a href="students/create">Create New</a>
</p>

<div>
    <QuickGrid Class="table" Items="students" Pagination="pagination">
        @* <PropertyColumn Property="student => student.last_name" /> *@
        @* <PropertyColumn Property="student => student.first_name" /> *@
        @* <PropertyColumn Property="student => student.middle_name" /> *@
        <PropertyColumn Property="student => student.FullName" Sortable="true"/>
        @* <PropertyColumn Property="student => student.birth_date" /> *@
        <TemplateColumn Title="¬озраст" Context="student" SortBy="@sortByBirth" >
            @{
                var age = DateTime.Now.Year - student.birth_date.Year;
                if ((DateTime.Now.Month < student.birth_date.Month) || ((DateTime.Now.Month == student.birth_date.Month) && (DateTime.Now.Day < student.birth_date.Day)))
                {
                    --age; 
                }
            }
            @age
        </TemplateColumn>
        @* <PropertyColumn Property="student => student.email" /> *@
        @* <PropertyColumn Property="student => student.phone" /> *@
        @* <PropertyColumn Property="student => student.photo" /> *@
        <PropertyColumn Property="student => student.Group.group_name" Sortable="true"/>
        <PropertyColumn Property="student => student.Group.Direction.direction_name" Sortable="true"/>

        <TemplateColumn Context="student">
            <a href="@($"students/edit?stud_id={student.stud_id}")">Edit</a>
        </TemplateColumn>
    </QuickGrid>
    <Paginator State="pagination" />
</div>

@code {
    private AcademyContext context = default!;
    IQueryable<Student> students = default!;
    PaginationState pagination = new PaginationState { ItemsPerPage = 10 };
    GridSort<Student> sortByBirth = GridSort<Student>.ByAscending(student => student.birth_date);
    //GridSort - это класс который сорирует по определенному типу (к примеру: по дню рождени€)
    //ByAscending - возвращает шаблон сортировки

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
        students = context
                    .Students
                    .Include(s => s.Group)
                    .ThenInclude(g => g.Direction);
        //—в€зь строитс€ по типу JOIN
    }


    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
