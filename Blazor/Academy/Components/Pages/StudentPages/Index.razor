@page "/students"
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using Academy.Models
@implements IAsyncDisposable
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Students</PageTitle>

<h1>Students</h1>

<p>
    <a href="students/create">Create New</a>
</p>

<div>
    <form action="/students">
        <input type="search" name="titleFilter"/>
        <input type="submit" value="Поиск" class="btn btn-primary"/>
    </form>
</div>

<div>
    <QuickGrid Class="table" Items="students" Pagination="pagination">
        @* <PropertyColumn Property="student => student.last_name" /> *@
        @* <PropertyColumn Property="student => student.first_name" /> *@
        @* <PropertyColumn Property="student => student.middle_name" /> *@
        <PropertyColumn Property="student => student.FullName" Sortable="true" Class="stud-name"/>
        @* <PropertyColumn Property="student => student.birth_date" /> *@
        <TemplateColumn Title="Age" Context="student" SortBy="@sortByBirth" Class="stud-age">
            @{
                var age = DateTime.Now.Year - student.birth_date.Year;
                if ((DateTime.Now.Month < student.birth_date.Month) || ((DateTime.Now.Month == student.birth_date.Month) && (DateTime.Now.Day < student.birth_date.Day)))
                {
                    --age; 
                }
            }
            @age
        </TemplateColumn>
        @* <PropertyColumn Property="student => student.email" /> *@
        @* <PropertyColumn Property="student => student.phone" /> *@
        @* <PropertyColumn Property="student => student.photo" /> *@
        <PropertyColumn Property="student => student.Group.group_name" Sortable="true" Class="name-stud"/>
        <PropertyColumn Property="student => student.Group.Direction.direction_name" Sortable="true" Class="gr-dir-name"/>
        <TemplateColumn Context="student">
            <a href="@($"students/edit?stud_id={student.stud_id}")">Edit</a>
        </TemplateColumn>
    </QuickGrid>
    <Paginator State="pagination" />
</div>

@code 
{
    private AcademyContext context = default!;
    IQueryable<Student> students = default!;
    string? TitleFilter { get; set; }
    //string? - означает, что поле может быть null
    IQueryable<Student> NameFilter => context.Students
                                        .Where(st => st.last_name
                                        .Contains(TitleFilter ?? string.Empty) && st.first_name
                                        .Contains(TitleFilter ?? string.Empty) && st.middle_name.
                                        Contains(TitleFilter ?? string.Empty));

    PaginationState pagination = new PaginationState { ItemsPerPage = 10 };
    GridSort<Student> sortByBirth = GridSort<Student>.ByAscending(student => student.birth_date);
    //GridSort - это класс который сорирует по определенному типу (к примеру: по дню рождения)
    //ByAscending - возвращает шаблон сортировки

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
        students = context
                    .Students
                    .Include(s => s.Group)
                    .ThenInclude(g => g.Direction);
        //Связь строится по типу JOIN
    }


    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
