@page "/studentss/delete"
@using Microsoft.EntityFrameworkCore
@using Academy.Models
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Students</h2>
    <hr />
    @if (students is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">last_name</dt>
            <dd class="col-sm-10">@students.last_name</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">first_name</dt>
            <dd class="col-sm-10">@students.first_name</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">middle_name</dt>
            <dd class="col-sm-10">@students.middle_name</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">birth_date</dt>
            <dd class="col-sm-10">@students.birth_date</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">email</dt>
            <dd class="col-sm-10">@students.email</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">phone</dt>
            <dd class="col-sm-10">@students.phone</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">photo</dt>
            <dd class="col-sm-10">@students.photo</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">group</dt>
            <dd class="col-sm-10">@students.group</dd>
        </dl>
        <EditForm method="post" Model="students" OnValidSubmit="DeleteStudents" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(students is null)">Delete</button> |
            <a href="/studentss">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private Students? students;

    [SupplyParameterFromQuery]
    private int stud_id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        students = await context.Students.FirstOrDefaultAsync(m => m.stud_id == stud_id);

        if (students is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteStudents()
    {
        using var context = DbFactory.CreateDbContext();
        context.Students.Remove(students!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/studentss");
    }
}
