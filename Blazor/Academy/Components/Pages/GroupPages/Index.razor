@page "/groups"
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using Academy.Models
@implements IAsyncDisposable
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Groups</PageTitle>

<div class="controls">
    <h1>Группы</h1>

    <p>
        <a href="groups/create" class="btn btn-primary">Добавить</a>
    </p>
</div>

<div class="controls">
    <form action="groups">
        <input type="search" name="titleFilter" />
        <input type="submit" value="Поиск" class="btn btn-primary" />
    </form>
</div>

<div>
    <QuickGrid Class="table" Items="groups" Pagination="pagination">
        @* <PropertyColumn Property="group => group.group_name" /> *@
        <TemplateColumn Context="group" Title="Group" Class="gr-name">
            @* Title="Group" - название для первой колонки *@
            <a href="@($"groups/details?group_id={group.group_id}")">@group.group_name</a>
        </TemplateColumn>
        <PropertyColumn Property="group => group.Direction.direction_name" Sortable="true" Class="gr-dir-name"/>
        <PropertyColumn Property="group => group.learning_days" Sortable="true" Class="gr-learning-days"/>
        <PropertyColumn Property="group => group.start_time" Sortable="true" Class="gr-start-time"/>
        <PropertyColumn Property="group => group.start_date" Sortable="true" Class="gr-start-date"/>

        @* <TemplateColumn Context="group">
        <a href="@($"groups/edit?group_id={group.group_id}")">Edit</a> |
        <a href="@($"groups/details?group_id={group.group_id}")">Details</a> |
        <a href="@($"groups/delete?group_id={group.group_id}")">Delete</a>
        </TemplateColumn> *@
    </QuickGrid>
    <Paginator State="pagination" />
</div>

@code {
    private AcademyContext context = default!;
    string? TitleFilter { get; set; }
    IQueryable<Group> groups = default!;
    PaginationState pagination = new PaginationState { ItemsPerPage = 10 };

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
        groups = context.Groups.Include(g => g.Direction);
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
