@page "/disciplines"
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using Academy.Models
@implements IAsyncDisposable
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Disciplines</PageTitle>

<h1>Disciplines</h1>

<p>
    <a href="disciplines/create">Create New</a>
</p>

<div class="controls">
    <form action="/disciplines">
        <input type="search" name="titleFilter" />
        <input type="submit" value="Поиск" class="btn btn-primary" />
    </form>
</div>

<div>
    <QuickGrid Class="table" Items="FilteredDisciplines" Pagination="pagination">
        <PropertyColumn Property="discipline => discipline.discipline_name" Sortable="true"     Class="discipline-name"/>
        <PropertyColumn Property="discipline => discipline.number_of_lessons" Sortable="true"   Class="discipline-lessons" />

        <TemplateColumn Context="discipline">
            <a href="@($"disciplines/edit?discipline_id={discipline.discipline_id}")">Edit</a> |
            <a href="@($"disciplines/details?discipline_id={discipline.discipline_id}")">Details</a> |
            <a href="@($"disciplines/delete?discipline_id={discipline.discipline_id}")">Delete</a>
        </TemplateColumn>
    </QuickGrid>
    <Paginator State="pagination" />
</div>

@code 
{
    private AcademyContext context = default!;
    PaginationState pagination = new PaginationState { ItemsPerPage = 10 };
    [SupplyParameterFromQuery]
    string? TitleFilter { get; set; }
    //string? - означает, что поле может быть null

    IQueryable<Discipline> FilteredDisciplines => 
    context.Disciplines.Where(d => d.discipline_name.Contains(TitleFilter ?? string.Empty));
    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}