@* <h3>Photo</h3> *@
@using Academy.Models

<div>
    @if (human.photo != null)
    {
        <img src="data:image/png;base64, @Convert.ToBase64String(human.photo)" alt="Photo" />
    }
</div>
<InputFile Onchange="LoadPhoto" />      @* Кнопка загрузить фото *@
@code 
{
    [Parameter]
    public IBrowserFile URL { get; set; }
    [Parameter]
    public Human human { get; set; }
    //от human класс наследуются - teacher и student классы
    //public byte[] Image { get; set; } = default!;
    async Task LoadPhoto(InputFileChangeEventArgs e)
    {
        URL = e.File;
        MemoryStream ms = new MemoryStream();
        await URL.OpenReadStream().CopyToAsync(ms);
        human.photo = ms.ToArray();
    }

}