@page "/fibonacci"
@rendermode InteractiveServer
<h1>Числа Фибоначи</h1>

<h4>Число</h4>
<input type="number" @bind="a"/>
<button @onclick="fibonacciFunction"> Расчитать</button>
<h4>Результат: @res</h4>
<h4>Debug: @a</h4>

@code 
{
	int a = 1;
	int b = 1;
	int c = 1;
	string res = "1 ";
	void fibonacciFunction()
	{
		while (a>=c)
		{
			int tmp = b+c;
			//сумма двух предыдущих чисел
			b = c;
			c = tmp;
			res += b.ToString()+" ";
			//складывается в массив
		}
	}
}
