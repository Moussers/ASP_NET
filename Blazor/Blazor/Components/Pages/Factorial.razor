@page "/factorial"
@rendermode InteractiveServer
<!--"rendermode InteractiveServer" - Отправка команды обработки события на сервер-->

<h3>Factorial</h3>

<input type="number" @bind="limit" /> 
<h3>!= @factorial</h3>
<button @onclick="Calculate">Calculate</button>

@code 
{
	int limit = 0;
	int factorial = 1;
	void Calculate()
	{
		factorial = 1;
		for (int i = 1; i <= limit; i++) 
			factorial *= i;
	}
	/*Обработчик событий всегда имеет тип: void*/
}
