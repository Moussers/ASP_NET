@if (Model.Students != null)
{
    <h3>Список студентов для выбранной группы:</h3>
    <table>
        <thead>
            <tr>
                <th>Фамилия</th>
                <th>Имя</th>
                <th>Отчество</th>
            </tr>
        </thead>

        <tbody>
            @foreach (Student student in Model.Students)
            {
                string selectedRow = "";
                @if (student.stud_id == (int?)ViewData["StudentID"]) selectedRow = "table-success";
                <tr class="@selectedRow">
                    <td>@Html.ActionLink("Select", "index", new  {studentID = student.stud_id})</td>
                    <td>@student.last_name</td>
                    <td>@student.first_name</td>
                    <td>@student.middle_name</td>
                </tr>
            }
        </tbody>
    </table>
}