@if (Model.Groups != null)
{
    <h3>Группы для данного направления:</h3>
    <table>
        <thead>
            <tr>Name</tr>
        </thead>

        <tbody>
            @foreach (Group gr in Model.Groups)
            {
                string selectedRow = "";
                if (gr.group_id == (int?)ViewData["DirectionID"]) selectedRow = "table-success";
                <tr class="@selectedRow">
                    <td>@Html.ActionLink("Select", "Index", new { groupID = gr.group_id })</td>
                    <td>@gr.group_name</td>
                </tr>
            }
        </tbody>
    </table>
}