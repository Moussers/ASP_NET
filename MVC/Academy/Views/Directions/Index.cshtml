@* @model IEnumerable<Academy.Models.Direction> *@
    @model PaginatedList<Direction>

@{
    ViewData["Title"] = "Index";
}

<div class="controls">
    <h1>Directions</h1>

    <form asp-action="Index" method="get">
        <div>
            <label>Поиск по имени: <input type="search" name="searchString" value="@ViewData["CurrentFilter"]" /></label>
            <input type="submit" value="Найти" class="btn btn-primary" />
            <a asp-action="Index" class="btn btn-secondary">Сброс</a>
        </div>
    </form>

    <a asp-action="Create" class="btn btn-primary">Добавить</a>
</div>

<table class="table">
    <thead>
        <tr>
            <th>
                @* <a asp-action="Index" asp-route-sortOrder="@ViewData["NameSortParam"]">@Html.DisplayNameFor(model => model.direction_name)</a> *@
                <a asp-action="Index" asp-route-sortOrder="@ViewData["NameSortParam"]">DirectionName</a>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.direction_name)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.direction_id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.direction_id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.direction_id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

@{
    string prevDisabled = Model.HasPreviousPage ? "" : "disabled";
    string nextDisabled = Model.HasNextPage ? "" : "disabled";
}

<a asp-action="Index"
    asp-route-pageNumber="@(Model.PageIndex - 1)"
    asp-route-currentFilter="@ViewData["CurrentFilter"]"
    class="btn btn-default @prevDisabled"
>
    Prev
</a>

<a asp-action="Index"
    asp-route-pageNumber="@(Model.PageIndex + 1)"
    asp-route-currentFilter="@ViewData["CurrentFilter"]"
    class="btn btn-default @nextDisabled"
>
    Next
</a>