@if (Model.Groups != null)
{
    <h3>Группы по выбранному направлению:</h3>
    <table>
        <thead>
            <tr>
                <th>Название группы</th>
            </tr>
        </thead>

        <tbody>
            @foreach (Group group in Model.Groups)
            {
                string selectedRow = "";
                if (group.group_id == (int?)ViewData["GroupID"]) selectedRow = "table-success";
                <tr class="@selectedRow">
                    <td>@Html.ActionLink("Select", "Index", new {groupID = group.group_id})</td>
                    <td>@group.group_name</td>
                </tr>
            }
        </tbody>
    </table>
}