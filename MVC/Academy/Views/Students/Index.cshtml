@* @model IEnumerable<Academy.Models.Student> *@
    @model PaginatedList<Student>

@{
    ViewData["Title"] = "Index";
}



<div class="controls">
    <h1>Students</h1>

    <form asp-action="Index" method="get">
        <div>
            <label>Поиск по имени: <input type="search" name="SearchString" value="@ViewData["CurrentFilter"]" /></label>
            <input type="submit" value="Найти" class="btn btn-primary" />
            <a asp-action="Index" class="btn btn-secondary">Сброс</a>
        </div>
    </form>

    <a asp-action="Create" class="btn btn-primary">Добавить</a>
</div>

<div class="paginator">
    <table class="table">
        <thead>
            <tr>
                <th>
                    @* <a asp-action="Index" asp-route-sortOrder="@ViewData["LNameSortParam"]">@Html.DisplayNameFor(model => model.last_name)</a> *@
                    <a asp-action="Index" asp-route-sortOrder="@ViewData["LNameSortParam"]">LastName</a>
                </th>
                <th>
                    @* <a asp-action="Index" asp-route-sortOrder="@ViewData["FNameSortParam"]">@Html.DisplayNameFor(model => model.first_name)</a> *@
                    <a asp-action="Index" asp-route-sortOrder="@ViewData["FNameSortParam"]">FirstName</a>
                </th>
                <th>
                    @* <a asp-action="Index" asp-route-sortOrder="@ViewData["MNameSortParam"]">@Html.DisplayNameFor(model => model.middle_name)</a> *@
                    <a asp-action="Index" asp-route-sortOrder="@ViewData["MNameSortParam"]">MiddleName</a>
                </th>
                <th>
                    @* <a asp-action="Index" asp-route-sortOrder="@ViewData["DateSortParam"]">@Html.DisplayNameFor(model => model.birth_date)</a> *@
                    <a asp-action="Index" asp-route-sortOrder="@ViewData["DateSortParam"]">BirthDate</a>
                </th>
                @* <th>
                @Html.DisplayNameFor(model => model.email)
                </th>
                <th>
                @Html.DisplayNameFor(model => model.phone)
                </th>
                <th>
                @Html.DisplayNameFor(model => model.photo)
                </th> *@
                <th>
                    @* <a asp-action="Index" asp-route-sortOrder="@ViewData["GroupSortParam"]">@Html.DisplayNameFor(model => model.group)</a> *@
                    <a asp-action="Index" asp-route-sortOrder="@ViewData["GroupSortParam"]">Group</a>
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model) {
            <tr>
                <td>
                    @Html.DisplayFor(model => item.last_name)
                </td>
                <td>
                    @Html.DisplayFor(model => item.first_name)
                </td>
                <td>
                    @Html.DisplayFor(model => item.middle_name)
                </td>
                <td>
                    @Html.DisplayFor(model => item.birth_date)
                </td>
                @* <td>
                @Html.DisplayFor(model => item.email)
                </td>
                <td>
                @Html.DisplayFor(model => item.phone)
                </td>
                <td>
                @Html.DisplayFor(model => item.photo)
                </td> *@
                <td>
                    @Html.DisplayFor(model => item.group)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.stud_id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.stud_id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.stud_id">Delete</a>
                </td>
            </tr>
            }
        </tbody>
    </table>
</div>

@{
    string prevDisabled = Model.HasPreviousPage ? "" : "disabled";
    string nextDisabled = Model.HasNextPage ? "" : "disabled";
}

<div class="pagination-controls">
    <a asp-action="Index"
        asp-route-pageNumber="@(Model.PageIndex - 1)"
        asp-route-currentFilter="@ViewData["CurrentFilter"]"
        class="btn btn-default @prevDisabled">
        Prev
    </a>
    <div>@Model.PageIndex</div>
    <div class="pages">
        @for (int i = 0; i < Model.TotalPages; i++)
        {
            @if (i + 1 == Model.PageIndex)
            {
        <a asp-action="Index"><div class="page current-page">@(i + 1)</div></a>
            }
            else
            {
                <div class="page">@(i + 1)</div>
            }
        }
    </div>
    <a asp-action="Index"
        asp-route-pageNumber="@(Model.PageIndex + 1)"
        asp-route-currentFilter="@ViewData["CurrentFilter"]"
        class="btn btn-default @nextDisabled">
        Next
    </a>
</div>