@model IEnumerable<Academy.Models.Discipline>

@{
    ViewData["Title"] = "Index";
}

<div class="controls">
    <h1>Discplines</h1>

    <a asp-action="Create" class="btn btn-primary">Добавить</a>
</div>

<form asp-action="Index" method="get">
    <div>
        <label>Поиск по названию дисциплины: <input type="search" name="SearchString" value="@ViewData["CurrentFilter"]"/></label>
        <input type="submit" value="Найти" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-secondary">Сброс</a>
    </div>
</form>
<table class="table">
    <thead>
        <tr>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["NameSortParam"]">@Html.DisplayNameFor(model => model.discipline_name)</a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["LessonSortParam"]">@Html.DisplayNameFor(model => model.number_of_lessons)</a>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.discipline_name)
            </td>
            <td>
                @Html.DisplayFor(model => item.number_of_lessons)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.discipline_id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.discipline_id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.discipline_id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
